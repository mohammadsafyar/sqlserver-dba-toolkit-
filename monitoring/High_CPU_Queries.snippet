<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>Running Queries - High CPU</Title>
      <Shortcut>highcpu</Shortcut>
      <Description>Shows currently running SQL Server requests ordered by CPU time</Description>
      <Author>DBA</Author>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
    </Header>

    <Snippet>
      <Code Language="SQL"><![CDATA[
-- Running Queries with high CPU time
--=========================================================================

SELECT TOP 200
       r.session_id,
       r.blocking_session_id,
       DB_NAME(r.database_id) AS DbName,
       t.text,
       r.command,
       r.percent_complete AS [Complete%],
       s.host_name,
       s.login_name,
       s.program_name,
       s.login_time,
       r.start_time,
       r.total_elapsed_time AS Duration_MS,
       r.cpu_time AS CpuTime_MS,
       r.logical_reads,
       r.reads,
       r.writes,
       r.wait_type,
       r.wait_time,
       r.last_wait_type
       --, qp.query_plan
FROM sys.dm_exec_requests r
INNER JOIN sys.dm_exec_sessions s
    ON s.session_id = r.session_id
CROSS APPLY sys.dm_exec_sql_text(r.sql_handle) t
--CROSS APPLY sys.dm_exec_query_plan(r.plan_handle) qp

WHERE r.session_id <> @@SPID
      --AND r.wait_time > 0
      --AND r.command = 'INSERT'
      --AND DB_NAME(r.database_id) = 'BssAgah'
      --AND t.text LIKE '%project2%'

ORDER BY r.cpu_time DESC;
]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>

